name "trackrs"
bin "trackrs"
about "Simple time tracker using CLI."
long_about "A simple time tracker using the CLI. Writes an entry with the current timestamp for each command that is invoked."
subcommand_required #true
arg_required_else_help #true

flag "-v --verbose" help="Increase logging verbosity" global=#true count=#true
flag "-q --quiet" help="Decrease logging verbosity" global=#true count=#true conflicts="verbose"

cmd "status" display_order=1 help="Get the status of current tracking" long_help="Get the status for either a day, a week or a month. Not providing additional options will return status for today." {
    flag "-w <week>" help="Week to show the status for" long_help="Either enter the correct week of the year or a relative value eg. -1" allow_hyphen_values=#true
    flag "-m <month>" help="Month to show the status for" long_help="Either enter the month of the year or a relative value eg. -1" allow_hyphen_values=#true conflicts="w"
    flag "-t --table" help="Format status as table. Default for week and month status, which --no-table turns off." negate="--no-table"
}
cmd "start" display_order=2 help="Start tracking work" long_help="Starts tracking work for today. Run again to continue after a break." {
    flag "-n --note <note>" help="Note to save with the entry"
}
cmd "break" display_order=3 help="Take a break" long_help="Breaks current tracking." {
    flag "-n --note <note>" help="Note to save with the entry"
}
cmd "end" display_order=4 help="End tracking work" long_help="End tracking work for today."
cmd "sick" display_order=5 help="Track sick for the rest of a day" long_help="Fills the remaining target work time of the day with sick. An empty day starts at 06:00 UTC, an ended day continues at its end and a running day continues now." {
    arg "[date]" help="Date as YYYY-MM-DD, defaults to today."
}
cmd "vacation" display_order=6 help="Track vacation for the rest of a day" long_help="Fills the remaining target work time of the day with vacation. An empty day starts at 06:00 UTC, an ended day continues at its end and a running day continues now." {
    arg "[date]" help="Date as YYYY-MM-DD, defaults to today."
}
cmd "add" display_order=7 help="Add minutes to today" long_help="Adds minutes of work to today, before the first start. Requires a start today, also works after end." {
    arg "<minutes>" help="Minutes to add to today."
}
cmd "takeover" display_order=8 help="Take over time to next day" long_help="Moves the end of today back by the given minutes and adds them before the next first start of a day. Today must be ended." {
    arg "<minutes>" help="Minutes to take over to the next day."
}
cmd "config" display_order=9 help="Configuration" long_help="List or edit configuration" {
    flag "-l --list" help="List configuration" conflicts="edit"
    flag "-e --edit" help="Open configuration in default editor" conflicts="list"
}
